# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env holds only the public Supabase URL/anon key (safe to
# commit, protected by RLS not secrecy) so builds work with zero setup.
# .env.local stays ignored for any personal local overrides.
.env.local

# typescript
*.tsbuildinfo

# personal Claude Code settings (permission allowlists, etc.)
.claude/settings.local.json

# ephemeral git worktrees created for isolated subagent runs
.claude/worktrees/
