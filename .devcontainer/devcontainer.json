{
  "name": "Fluffy Inventory",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  "postStartCommand": "cp -n .env.example .env.local || true",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Fluffy Inventory (dev)",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
